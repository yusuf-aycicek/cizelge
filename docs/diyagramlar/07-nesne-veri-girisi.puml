@startuml 07-nesne-veri-girisi
!include _stil.iuml
title Nesne diyagramı (1/2): örnek okuldan bir kesit, veri girişinden sonra (9-A ve 9-B)

' Nesneler 02 ve 04'teki sınıfların örnekleridir; alan adları onlarla aynıdır (test_diyagramlar.py
' denetler). Kimlikler (uuid) okunabilirlik için kısa adlarla gösterilir. Kişi adları uydurmadır.

object "okul : Okul" as okul {
  id = <okul>
  ad = "Örnek Anadolu Lisesi"
  gun_sayisi = 5
  gunluk_ders_saati = 8
  ogle_arasi_sonra = 4
}

object "s9a : Sinif" as s9a {
  id = s-9a
  okul_id = <okul>
  ad = "9-A"
  seviye = 9
  sube_grubu_id = null
}
object "s9b : Sinif" as s9b {
  id = s-9b
  okul_id = <okul>
  ad = "9-B"
  seviye = 9
  sube_grubu_id = null
}

object "mat : Ders" as mat {
  id = d-mat
  ad = "Matematik"
  kisa_ad = "MAT"
}
object "fel : Ders" as fel {
  id = d-fel
  ad = "Felsefe"
  kisa_ad = "FEL"
}

object "ece : Ogretmen" as ece {
  id = o-ece
  okul_id = <okul>
  ad = "Ece Örnek"
  brans = "Matematik"
}
object "kaan : Ogretmen" as kaan {
  id = o-kaan
  okul_id = <okul>
  ad = "Kaan Deneme"
  brans = "Felsefe"
}

object "sablon9mat : SeviyeSablonu" as sb1 {
  seviye = 9
  sube_grubu_id = null
  ders_id = d-mat
  haftalik_saat = 6
}
object "sablon9fel : SeviyeSablonu" as sb2 {
  seviye = 9
  sube_grubu_id = null
  ders_id = d-fel
  haftalik_saat = 2
}

object "istisna : SubeDersIstisnasi" as ist {
  sinif_id = s-9a
  ders_id = d-fel
  tur = "almaz"
  haftalik_saat = null
}

object "a1 : DersAtama" as a1 {
  id = a-9a-mat
  sinif_id = s-9a
  ders_id = d-mat
  ogretmen_id = o-ece
  haftalik_saat = 6
}
object "a2 : DersAtama" as a2 {
  id = a-9b-mat
  sinif_id = s-9b
  ders_id = d-mat
  ogretmen_id = o-ece
  haftalik_saat = 6
}
object "a3 : DersAtama" as a3 {
  id = a-9b-fel
  sinif_id = s-9b
  ders_id = d-fel
  ogretmen_id = o-kaan
  haftalik_saat = 2
}

object "cuma : Musaitlik" as mus {
  ogretmen_id = o-kaan
  gun = 4
  saat = 0
  durum = "gelemez"
}

object "kaanGunluk : Kisit" as k1 {
  tur = "ogretmen_gunluk_siniri"
  parametreler = {"m": 6}
  zorunlu = true
  ogretmen_id = o-kaan
  okul_geneli = false
}
object "matBlok : Kisit" as k2 {
  tur = "blok_deseni"
  parametreler = {"desen": [2, 2, 2]}
  zorunlu = true
  ders_id = d-mat
  okul_geneli = false
}

okul -- s9a
okul -- s9b
okul -- ece
okul -- kaan
sb1 --> mat : ders_id
sb2 --> fel : ders_id
s9a *-- ist
ist --> fel : ders_id
a1 --> s9a : sinif_id
a1 --> mat
a1 --> ece : ogretmen_id
a2 --> s9b : sinif_id
a2 --> mat
a2 --> ece
a3 --> s9b : sinif_id
a3 --> fel
a3 --> kaan : ogretmen_id
kaan *-- mus
kaan *-- k1 : özel ayar
mat *-- k2 : özel ayar

note bottom of ist
  "9-A Felsefe almaz": şablon (9. seviye: Matematik 6, Felsefe 2)
  uygulanınca 9-A'ya Felsefe ataması açılmaz, 9-B'ye açılır.
  Şablon yeniden uygulansa da istisna korunur (K5).
end note

note right of k1
  Öğretmene özel ayar (ADR 0016): okul geneli
  günde en fazla 8 saat (M), Kaan Deneme için 6.
  En özel kapsam kazanır.
end note

note right of k2
  Derse özel blok şekli: Matematik
  "2+2+2" (okul önerisi 6 saat için de
  2+2+2; burada açıkça seçildi, düşmez).
end note

note bottom of mus
  Kaan Deneme cuma bütün gün gelemez: 8 saat
  için 8 Musaitlik nesnesi (biri gösterildi).
  Başka okulda da görevli öğretmen böyle girilir.
end note
@enduml
