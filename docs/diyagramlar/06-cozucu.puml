    +mesajlar : list[str]
    +celiskiler : list[Celiski]
    +sure_sn : float
    +basarili : bool
  }
  enum CozumDurumu {
    OPTIMAL
    UYGUN
    COZUMSUZ
    ON_KONTROL_HATASI
    BILINMIYOR
  }
  class KisitTanimi <<dataclass>> {
    +tur : str
    +parametreler : dict
    +zorunlu : bool
    +agirlik : int
