@startuml 06-cozucu
!include _stil.iuml
title Çözücü: ProgramCozucu arayüzü, CpSatCozucu ve kısıt kuralları (strategy deseni)
hide empty members

class CpModel <<harici>>

' @kod cozucu.arayuz
package "arayuz" {
  interface ProgramCozucu {
    +coz(girdi : CozumGirdisi, sure_siniri_sn : float = 120) : CozumSonucu
  }
}

' @kod cozucu.cpsat
package "cpsat" {
  class CpSatCozucu {
    +is_parcacigi : int
    +tohum : int
    +gozlemci : Gozlemci [0..1]
    +iki_asamali : bool
    +coz(girdi : CozumGirdisi, sure_siniri_sn : float) : CozumSonucu
    -_ilk_asama(girdi, sure, baslangic)
    -_ana_cozum(baglam, sure, baslangic)
    -_uygunluk_kontrolu(girdi, sure) : int
  }
}

' @kod cozucu.kisitlar.temel
package "kisitlar.temel" {
  abstract class KisitKurali <<strateji>> {
    {static} +tur : str
    {static} +zorunlu_olabilir : bool
    {static} +esnek_olabilir : bool
    {static} +kapsamlar : frozenset[str]
    +zorunlu : bool
    +agirlik : int
    +ozel : tuple[tuple[Kapsam, KisitKurali]]
    +deger(baglam, ad, sinif_id, ders_id, ogretmen_id) : int
    {abstract} +uygula(baglam : Baglam) : list[CezaTerimi]
  }
  class Baglam {
    +girdi : CozumGirdisi
    +model : CpModel
    +x : dict[tuple[atama, gün, saat], BoolVar]
    +gunler : range
    +saatler : range
    +gruplar : dict [0..1]
    {static} +kur(girdi : CozumGirdisi, analiz : bool) : Baglam
    +hucre(atama_id, gun, saat) : BoolVar
    +dolu(atamalar, gun, saat) : LinearExpr
    +grupla(kisit, *anahtar)
  }
  class temel <<modül>> {
    {static} +KAYIT_DEFTERI : dict[str, type[KisitKurali]]
    {static} +kaydet(sinif)
    {static} +kural_olustur(tanim : KisitTanimi, ozeller) : KisitKurali
  }
}

