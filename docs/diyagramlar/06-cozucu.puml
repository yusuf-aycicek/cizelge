' @kod cozucu.model
package "model (düz veri)" {
  class CozumGirdisi <<dataclass>> {
    +ayar : OkulAyari
    +ogretmenler : list[Ogretmen]
    +siniflar : list[Sinif]
    +dersler : list[Ders]
    +atamalar : list[DersAtama]
    +musaitlikler : list[Musaitlik]
    +kisitlar : list[KisitTanimi]
    +kilitli_yerlesimler : list[Yerlesim]
    +temel_yerlesimler : list[TemelYerlesim]
  }
  class CozumSonucu <<dataclass>> {
    +durum : CozumDurumu
    +yerlesimler : list[Yerlesim]
