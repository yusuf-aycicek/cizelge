@startuml 05-ders-programi-katmanlar
!include _stil.iuml
title Ders programı modülü (2/2): servisler, depolar, program üretimi ve iş kuyruğu
hide empty members

skinparam class<<çekirdek>> {
  BackgroundColor #EEF4FB
  BorderColor #6C8EBF
}

' @kod okulapi.cekirdek.servisler
package "okulapi.cekirdek.servisler" {
  abstract class CrudServisi <<çekirdek>>
}
' @kod okulapi.cekirdek.depo
package "okulapi.cekirdek.depo" {
  class OkulaAitDepo <<çekirdek>>
}
' @kod okulapi.cekirdek.modul
package "okulapi.cekirdek.modul" {
  class Modul <<çekirdek>>
}
' @kod okulapi.cekirdek.kuyruk
package "okulapi.cekirdek.kuyruk (RQ yalnızca burada)" {
  interface IsKuyrugu <<çekirdek>> {
    +kuyruga_ekle(is_id : str, fonksiyon : str, argumanlar : dict, zaman_asimi_sn : int, basarisizlikta : str)
    +kuyrukta_mi(is_id : str) : bool
  }
  class RqKuyrugu <<çekirdek>> {
    +redis_url : str
    +kuyruk_adi : str
  }
  class BellekKuyrugu <<çekirdek>> {
    +isler : dict[str, KayitliIs]
    +ulasilamaz : bool
    +bitir(is_id : str)
    +kaybet(is_id : str)
  }
  class KuyrukHatasi <<istisna>>
}

' @kod okulapi.moduller.ders_programi
package "ders_programi (paket)" {
  class ders_programi <<modül>> {
    {static} +MODUL : Modul
  }
}

' @kod okulapi.moduller.ders_programi.servisler
package "servisler" {
  class SeviyeSablonuServisi {
    +uygula(seviye : int) : dict
    #_dogrula(alanlar, nesne)
  }
  class DersAtamaServisi {
    #_dogrula(alanlar, nesne)
  }
  class MusaitlikServisi {
    #_dogrula(alanlar, nesne)
  }
  class KisitServisi {
    #_dogrula(alanlar, nesne)
  }
  class ProgramServisi {
    +kuyruk : IsKuyrugu [0..1]
    +uret(ad : str, temel_program_id : UUID, sure_siniri_sn : int) : Program
    +listele() : list[Program]
    +getir(program_id : UUID) : Program
    +yerlesimler(program_id : UUID) : list[Yerlesim]
    -_temizle()
  }
}

' @kod okulapi.moduller.ders_programi.depo
package "depo" {
  class SeviyeSablonuDeposu {
    +seviyenin(seviye : int) : list[SeviyeSablonu]
  }
  class DersAtamaDeposu {
    +siniflarin(sinif_idler : list[UUID]) : list[DersAtama]
  }
  class YerlesimDeposu {
    +programin(program_id : UUID, yalnizca_kilitli : bool) : list[Yerlesim]
  }
}

' @kod okulapi.moduller.ders_programi.uretim
package "uretim (worker'ın işi)" {
  class uretim <<modül>> {
    {static} +programi_uret(fabrika, okul_id, program_id, cozucu, bulunamazsa_bekle) : UretimSonucu
    {static} +takili_uretimleri_temizle(oturum : Session, kuyruk : IsKuyrugu) : int
    {static} +uretimi_basarisiz_yap(fabrika, okul_id, program_id, mesaj : str) : bool
    {static} +girdi_ozeti(girdi : CozumGirdisi) : str
    {static} +uretim_isi(okul_id : str, program_id : str) : str
    {static} +uretim_basarisiz_oldu(okul_id : str, program_id : str, zaman_asimi : bool)
  }
  enum UretimSonucu {
    ATLANDI
    HAZIR
    BASARISIZ
  }
}

