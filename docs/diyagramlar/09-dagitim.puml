@startuml 09-dagitim
!include _stil.iuml
title Dağıtım diyagramı: docker compose up --build (geliştirme ortamı)

skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam node<<planlanan>> {
  BackgroundColor #F6F6F6
  BorderColor #A0A0A0
  FontColor #8A8A8A
}
skinparam artifact<<planlanan>> {
  BackgroundColor #F6F6F6
  BorderColor #A0A0A0
  FontColor #8A8A8A
}

node "Geliştirici bilgisayarı\n<<cihaz>>\nWindows 11" as pc {
  node "Tarayıcı" as tarayici
  node "pytest\n(api/.venv, cozucu/.venv)" as testler

  node "Docker Desktop (WSL2)\n<<yürütme ortamı>>" as docker {
    node "db\n<<konteyner>>\npostgres:17" as db {
      database "okul\n(ve testler için okul_test)" as okuldb
      artifact "rol: okul_sahip\n(tablo sahibi, süper kullanıcı;\nmigration'lar)" as rol_sahip
      artifact "rol: okul_uygulama\n(uygulama; RLS'ye tabi,\nyalnızca DML yetkisi)" as rol_uyg
      artifact "01-uygulama-rolu.sh\n(docker-entrypoint-initdb.d)" as init
    }
    storage "db_verisi\n<<birim>>" as birim

    node "api\n<<konteyner>>\npython:3.14-slim" as api {
      artifact "okulapi\n(FastAPI, uvicorn)" as okulapi
      artifact "cozucu\n(OR-Tools CP-SAT)" as cozucu
      artifact "migrasyon\n(Alembic: upgrade heads)" as migrasyon
    }

    node "redis\n<<konteyner>>\nredis:7.4" as redis {
      queue "program_uretimi\n(RQ kuyruğu;\niş kimliği = program kimliği)" as kuyruk
    }

    node "worker\n<<konteyner>>\napi ile aynı imaj" as worker {
      artifact "okulworker\n(python -m okulworker;\nRQ worker'ı, iş başına fork)" as okulworker
      artifact "okulapi + cozucu\n(iş fonksiyonu:\nuretim.uretim_isi)" as isler
    }
    node "web\n<<konteyner>>\n(React, Vite derlemesi)" <<planlanan>> as web #F6F6F6;line.dashed;line:9A9A9A;text:8A8A8A
  }
}

tarayici --> api : HTTP\nlocalhost:8000 → api:8000\n(/docs, /api/...)
testler --> db : TCP/PostgreSQL\nlocalhost:5433 → db:5432
okulapi --> rol_uyg : bağlanır (db:5432)\nOKULAPI_VERITABANI_URL
migrasyon --> rol_sahip : bağlanır (db:5432)\nOKULAPI_MIGRASYON_URL
db --> birim : /var/lib/postgresql/data
init ..> rol_uyg : ilk açılışta oluşturur
okulapi ..> cozucu : import
okulapi --> kuyruk : işi ekler, "kuyrukta mı?"\n(redis:6379, port dışarı açılmaz)
okulworker --> kuyruk : işi alır
okulworker ..> isler : çalıştırır
isler --> rol_uyg : bağlanır (db:5432)\nRLS, işteki okul_id ile

tarayici ..> web #9A9A9A;line.dashed : HTTP (planlanan)
web ..> api #9A9A9A;line.dashed : /api/... (planlanan)

note right of db
  Konteyner içinde 5432; bilgisayara 5433 ile açılır
  (aynı makinedeki başka projeler 5432 kullanıyor).
  api, db ve redis sağlıklı olmadan başlamaz (healthcheck).
  worker, api sağlıklı olmadan başlamaz: migration'ları api uygular.
end note

note bottom of worker
  Ölçeklenir: docker compose up --scale worker=3.
  Aynı iş iki kez yapılmaz (FOR UPDATE, ADR 0011).
end note

legend right
  Düz çizgi, beyaz: şu an çalışan.
  Kesik çizgi, gri, <<planlanan>>: henüz yapılmadı
  (web: yapım sırası 5).
endlegend
@enduml
