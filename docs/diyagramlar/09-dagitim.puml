@startuml 09-dagitim
!include _stil.iuml
title Dağıtım diyagramı: docker compose up --build (tek makine) ve yayın ortamı için not

skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam node<<planlanan>> {
  BackgroundColor #F6F6F6
  BorderColor #A0A0A0
  FontColor #8A8A8A
}

node "Kullanıcının bilgisayarı / telefonu\n<<cihaz>>" as cihaz {
  node "Web tarayıcısı\n<<yürütme ortamı>>" as tarayici {
    artifact "React uygulaması\n(TypeScript, derlenmiş JS paketi)" as spa
    artifact "oturum çerezi\nHttpOnly, SameSite=Strict" as cerez
  }
}

node "Sunucu (Docker Engine / Docker Desktop)\n<<cihaz>>" as sunucu {
  node "Docker Compose projesi\n<<yürütme ortamı>>" as compose {

    node "web\n<<konteyner>>\nnode:22-alpine\nport 5173 (WEB_PORT)" as web {
      artifact "Vite sunucusu\n(npm run dev)" as vite
      artifact "web/src\n(React kaynakları)" as webkaynak
    }
    storage "web_paketleri\n<<birim>>\nnode_modules" as paketler

    node "api\n<<konteyner>>\npython:3.14-slim (api/Dockerfile)\nport 8000 (API_PORT)" as api {
      artifact "okulapi\n(FastAPI + uvicorn)" as okulapi
      artifact "cozucu\n(OR-Tools CP-SAT; ön kontrol)" as cozucu_api
      artifact "migrasyon\n(Alembic: upgrade heads)" as migrasyon
      artifact "veri/*.json\n(ornek-okul komutu)" as veriseti
    }

    node "worker\n<<konteyner>>\napi ile aynı imaj\n(--scale worker=N)" as worker {
      artifact "okulworker\n(python -m okulworker;\nRQ worker, iş başına fork)" as okulworker
      artifact "okulapi + cozucu\n(uretim.uretim_isi)" as isler
    }

    node "redis\n<<konteyner>>\nredis:7.4\n(dışarıya port açılmaz)" as redis {
      queue "program_uretimi\n(RQ kuyruğu;\niş kimliği = program kimliği)" as kuyruk
    }

    node "db\n<<konteyner>>\npostgres:17\nport 5433 → 5432 (DB_PORT)" as db {
      database "okul\n(RLS açık tablolar)" as okuldb
      artifact "rol: okul_sahip\n(tablo sahibi; migration'lar)" as rol_sahip
      artifact "rol: okul_uygulama\n(api ve worker; RLS'ye tabi,\nyalnızca DML)" as rol_uyg
      artifact "rol: okul_giris (NOLOGIN)\nSECURITY DEFINER fonksiyonlar:\ngiris_bilgisi, oturum_coz,\nkaba kuvvet sayacı (ADR 0012)" as rol_giris
      artifact "rol: okul_paylasim (NOLOGIN)\npaylasim_icerigi(jeton)\n(girişsiz link, ADR 0022)" as rol_paylasim
      artifact "01-uygulama-rolu.sh\n(docker-entrypoint-initdb.d)" as init
    }
    storage "db_verisi\n<<birim>>" as birim
  }
}

tarayici --> vite : HTTP :5173\n(sayfa + /api aynı köken)
vite --> okulapi : Vite proxy\n/api → http://api:8000\n(ADR 0013)
vite ..> webkaynak : derler, sunar
web --> paketler
spa ..> cerez
okulapi --> rol_uyg : TCP db:5432\nOKULAPI_VERITABANI_URL
migrasyon --> rol_sahip : TCP db:5432\nOKULAPI_MIGRASYON_URL
okulapi --> kuyruk : RESP redis:6379\nişi ekler / "kuyrukta mı?"
okulworker --> kuyruk : işi alır
okulworker ..> isler : çalıştırır
isler --> rol_uyg : TCP db:5432\nSET LOCAL app.okul_id
rol_uyg ..> rol_giris : yalnızca EXECUTE\n(okul bilinmeden arama)
rol_uyg ..> rol_paylasim : yalnızca EXECUTE
db --> birim : /var/lib/postgresql/data
init ..> rol_uyg : ilk açılışta oluşturur

node "Yayın ortamı (önerilen)\n<<planlanan>>" as yayin #F6F6F6;line.dashed {
  artifact "ters vekil (nginx / Caddy)\nHTTPS :443\n/ → web/dist (npm run build)\n/api → api:8000" as vekil
}
tarayici ..> vekil : HTTPS\n(çerez Secure)
vekil ..> okulapi : HTTP (iç ağ)

note right of db
  Başlama sırası (healthcheck):
  db, redis sağlıklı → api (önce migration) →
  api sağlıklı → worker, web.
  Bilgisayardan erişim yalnızca testler için (5433).
end note

note bottom of worker
  Aynı iş iki kez yapılmaz (FOR UPDATE, ADR 0011).
  Çözücü API sürecinde değil worker'da çalışır:
  uzun süren üretim diğer istekleri bekletmez.
end note

legend right
  Düz ok: çalışma anı iletişimi (protokol, hedef port)
  Kesik ok: yerel bağımlılık / yayın ortamında yol
  Portlar .env ile değiştirilebilir (.env.example).
endlegend
@enduml
