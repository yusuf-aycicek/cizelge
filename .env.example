# Docker Compose ayarları. Kullanmak için bu dosyayı .env adıyla kopyalayın; hiçbiri zorunlu değildir
# (verilmezse aşağıdaki varsayılanlar kullanılır). .env depoya girmez.

# Bilgisayarda açılan portlar. Bilgisayarda bu portlardan biri doluysa değiştirin; arayüz adresi
# http://localhost:<WEB_PORT> olur ve API'nin köken denetimi yeni portu kendiliğinden izler.
WEB_PORT=5173
API_PORT=8000
DB_PORT=5433

# Veritabanı parolaları docker-compose.yml içinde yalnızca geliştirme değerleridir. Yayında
# OKULAPI_VERITABANI_URL, OKULAPI_MIGRASYON_URL ve POSTGRES_PASSWORD gizli değişkenlerden gelmeli,
# OKULAPI_CEREZ_SECURE verilmemeli (varsayılan: true, yalnızca HTTPS).
