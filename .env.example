# Docker Compose ayarları. Kullanmak için bu dosyayı .env adıyla kopyalayın; hiçbiri zorunlu değildir
# (verilmezse aşağıdaki varsayılanlar kullanılır). .env depoya girmez.

# Bilgisayarda açılan portlar. Bilgisayarda bu portlardan biri doluysa değiştirin; arayüz adresi
# http://localhost:<WEB_PORT> olur ve API'nin köken denetimi yeni portu kendiliğinden izler.
WEB_PORT=5173
API_PORT=8000
DB_PORT=5433

# Veritabanı parolaları docker-compose.yml içinde yalnızca geliştirme değerleridir. Yayında
# OKULAPI_VERITABANI_URL, OKULAPI_MIGRASYON_URL ve POSTGRES_PASSWORD gizli değişkenlerden gelmeli,
# OKULAPI_CEREZ_SECURE verilmemeli (varsayılan: true, yalnızca HTTPS).

# --- Yayın (Render + Neon + Cloudflare Pages, docs/adr/0026) ---------------------------------
# Bu değerler .env'e değil, barındırıcıların paneline girilir (render.yaml hangilerinin
# sorulacağını söyler). Burada yalnızca biçimleri gösterilir; gerçek parolalar depoya yazılmaz.
#
# Render (API servisi):
# OKULAPI_VERITABANI_URL=postgresql://okul_uygulama:<parola>@ep-....eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# OKULAPI_MIGRASYON_URL=postgresql://neondb_owner:<parola>@ep-....eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# OKULAPI_DEMO_PAROLA=<demo hesabının parolası: en az 12, en çok 256 karakter (kimlik/parola.py)>
#   Tanımlıysa giriş sayfasında "Demo ile dene" düğmesi görünür (ADR 0027); parola arayüze gitmez.
# OKULAPI_DEMO_SIFIRLAMA_DK=60  (demo okul bundan eskiyse sonraki demo girişi onu baştan kurar)
# OKULAPI_IZINLI_KOKENLER=["https://<render-servisi>.onrender.com","https://<pages-projesi>.pages.dev","http://localhost:5173"]
#   Arayüz Render'daki aynı servisten sunulur (ADR 0028); Pages adresi geçiş için duruyor.
# OKULAPI_COZUCU_IS_PARCACIGI=2
# OKULAPI_REDIS_URL  (Render Key Value servisinden kendiliğinden gelir)
#
# Cloudflare Pages (arayüz):
# API_KOKENI=https://<render-servisi>.onrender.com
